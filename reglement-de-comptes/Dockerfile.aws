# ==============================================================================
# Règlement de comptes : Image unifiée AWS (Angular + FastAPI)
# ==============================================================================

# Étape 1 : Construction du frontend Angular (Node 22)
FROM node:22-alpine AS build-frontend
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npx ng build

# Étape 2 : Image runtime Python FastAPI
FROM python:3.12-slim
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    RDC_DATA_DIR=/data \
    RDC_STATIC_DIR=/app/frontend/dist/menu/browser

# Utilisateur non-root sécurisé
RUN useradd --create-home --uid 1000 app

# Dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Code backend et données du tribunal
COPY --chown=app:app backend ./backend
COPY --chown=app:app data /data

# Intégration du build Angular généré à l'étape 1
COPY --from=build-frontend --chown=app:app /app/frontend/dist /app/frontend/dist

USER app

# Port 8501 (conforme au Target Group ALB AWS existant)
EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/api/sante')" || exit 1

# Démarrage de l'API FastAPI et de l'interface Angular unifiée
CMD ["uvicorn", "api:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8501"]
